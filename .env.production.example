# Non-secret template. No account, provider or infrastructure is provisioned.
# Copy outside Git, restrict its permissions and review every value before use.
APP_DOMAIN=muqola.tlam.art
MUQOLA_PROJECT=muqola-prod
PROXY_NETWORK=proxy
# Exact, stable Caddy container IP(s); no subnet/wildcard. Replace before use.
TRUSTED_PROXY_IPS=REPLACE_WITH_CADDY_CONTAINER_IP
MUQOLA_IMAGE=ghcr.io/tlamart/muqola@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=postgres:17.12-bookworm@sha256:40865bc877a289da75963d97d72b59633f639fc5af7a4e856bfa3714cae5b536
POSTGRES_DB=muqola
# Mounted files, NOT secret values in this environment file.
SECRETS_DIR=/etc/muqola/secrets
LEGAL_DOCUMENTS_DIR=/etc/muqola/legal
LEGAL_REVIEWED=false
EMAIL_HOST=smtp.example.test
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_LOGIN
EMAIL_FROM=notifications@muqola.example.test
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
