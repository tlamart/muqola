# TEMPLATE ONLY. Never commit real production values.
# Copy to .env.production outside version control and restrict permissions (chmod 600).
APP_DOMAIN=muqola.example.test
APP_ENV=production
APP_BASE_URL=https://muqola.example.test
ALLOWED_HOSTS=muqola.example.test
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
POSTGRES_DB=muqola
POSTGRES_USER=muqola
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# SMTP is intentionally NOT configured in PR #24.
# PR #25 must supply verified real SMTP settings before public registration.
EMAIL_HOST=REPLACE_WITH_VERIFIED_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_LOGIN
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_SECRET
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=notifications@muqola.example.test
