# Développement local uniquement ; cp .env.example .env puis générer les deux secrets.
APP_ENV=development
# Origine des liens envoyés, jamais déduite du Host reçu.
APP_BASE_URL=http://localhost:8000
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_50_RANDOM_CHARACTERS
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=muqola
POSTGRES_USER=muqola
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_RANDOM_PASSWORD
# Avec Compose les hôtes sont imposés à db et mailpit (réseau interne).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
# Aucun fournisseur réel ni clé API au lot 0.
