# Site fragment imported by the shared Caddy; no global/admin/TLS overrides.
{$APP_DOMAIN:muqola.tlam.art} {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy muqola-web:8000 {
		# Never trust a client-supplied forwarding value at this public edge.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
